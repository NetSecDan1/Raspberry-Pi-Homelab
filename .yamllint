---
# yamllint config, tuned to agree with ansible-lint's expectations.
extends: default

ignore: |
  .venv/
  .ansible/

rules:
  line-length:
    max: 160
    level: warning
  truthy:
    # GitHub Actions uses the bare key `on:`.
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
