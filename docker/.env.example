# Copy to .env ONLY for manual/local use. On the Pi, Ansible renders .env
# from roles/stack/templates/env.j2 using environment variables / GitHub
# Secrets. Never commit a real .env (it's in .gitignore).

# Timezone for container logs and Watchtower's schedule.
TZ=Etc/UTC

# Pi-hole admin UI password. Must not contain a single quote (').
PIHOLE_WEBPASSWORD=change-me
